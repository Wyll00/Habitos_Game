# Copia este archivo a ".env" y rellena tus datos reales.
# En Supabase: Project Settings -> Database -> Connection string -> URI
# Usa el "Connection pooler" (Session mode) y añade ?sslmode=require al final.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# false en producción/online; true solo para desarrollar en tu PC
FLASK_DEBUG=false

# Login de la app
# SECRET_KEY: cadena larga y aleatoria. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pon_aqui_una_cadena_larga_y_aleatoria
# APP_PASSWORD: la contraseña con la que entrarás a la app. Elige una buena.
# Si la dejas vacía, la app NO pedirá login (solo para desarrollo local).
APP_PASSWORD=tu_contraseña_secreta
